# Required — issued from RelataSQL settings → API Keys. Authorizes
# every request this MCP server makes on behalf of the user.
RELATASQL_API_KEY=

# Optional — RelataSQL API base URL. Defaults to the official cloud API
# (https://api.relatasql.com). Only set this if you run a self-hosted
# backend or are developing locally (e.g. http://localhost:3000).
# RELATASQL_API_URL=https://api.relatasql.com
