# RelataSQL MCP supports two transports.
#
# 1) stdio (local IDE/CLI clients): RELATASQL_API_KEY is required.
# 2) Streamable HTTP (remote clients): each request supplies its own OAuth
#    bearer token, so a global RELATASQL_API_KEY must NOT be configured.

# stdio only — issued from RelataSQL Settings -> API Keys.
RELATASQL_API_KEY=

# Shared backend API base URL.
# RELATASQL_API_URL=https://api.relatasql.com

# Remote Streamable HTTP server.
# RELATASQL_MCP_HOST=0.0.0.0
# RELATASQL_MCP_PORT=3003
# RELATASQL_MCP_PUBLIC_BASE_URL=https://mcp.relatasql.com
# RELATASQL_MCP_ALLOWED_HOSTS=mcp.relatasql.com
